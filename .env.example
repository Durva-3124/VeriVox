# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only; never sent to frontend).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VERIVOX_MASTER_SECRET: Private HMAC signing secret for issuing ephemeral stream tokens.
# Resides exclusively in server-side memory/env; never bundled into client JS.
VERIVOX_MASTER_SECRET="vx_sec_enterprise_master_key_never_expose_to_client"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Frontend data source for the live audio stream.
# Point this at FastAPI's real stream endpoint on port 8000, not the Express mock on port 3000.
VITE_STREAM_API_BASE="http://localhost:8000"
VITE_WS_URL="ws://localhost:8000/stream"

